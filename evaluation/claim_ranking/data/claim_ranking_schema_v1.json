{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim-ranking evaluation dataset",
  "description": "Schema for a manually labeled, claim-level fact-checking priority dataset. The repository does not currently contain a populated dataset.",
  "type": "object",
  "required": [
    "dataset_id",
    "version",
    "description",
    "labeling_guide_version",
    "examples"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "labeling_guide_version": {
      "type": "string",
      "minLength": 1
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/example"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "example": {
      "type": "object",
      "required": [
        "claim_id",
        "claim",
        "relevance_grade",
        "rationale",
        "baseline_ranks",
        "ecs"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "relevance_grade": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "baseline_ranks": {
          "type": "object",
          "required": [
            "O1",
            "O2",
            "O3"
          ],
          "additionalProperties": false,
          "properties": {
            "O1": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "O2": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "O3": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "ecs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "reproduction_notes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "content"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "license": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "exclusion": {
      "type": "object",
      "required": [
        "claim_id",
        "reason"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
